{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "compare.v1 output",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["spanId", "quote"],
      "additionalProperties": false,
      "properties": {
        "spanId": { "type": "string", "pattern": "^D\\d+-P\\d+-S\\d+$" },
        "quote": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/definitions/citation" } }
      }
    }
  },
  "properties": {
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "notice", "agreement", "explanation", "severity"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "notice": { "$ref": "#/definitions/claim" },
          "agreement": { "$ref": "#/definitions/claim" },
          "explanation": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
