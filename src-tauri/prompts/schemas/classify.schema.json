{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "classify.v1 output",
  "type": "object",
  "required": ["docType", "summary"],
  "additionalProperties": false,
  "definitions": {
    "citation": {
      "type": "object",
      "required": ["spanId", "quote"],
      "additionalProperties": false,
      "properties": {
        "spanId": { "type": "string", "pattern": "^D\\d+-P\\d+-S\\d+$" },
        "quote": { "type": "string", "maxLength": 300 }
      }
    },
    "claim": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/definitions/citation" } }
      }
    }
  },
  "properties": {
    "docType": { "$ref": "#/definitions/claim" },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "claim"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "claim": { "$ref": "#/definitions/claim" }
        }
      }
    },
    "summary": { "$ref": "#/definitions/claim" }
  }
}
