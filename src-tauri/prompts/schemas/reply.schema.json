{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reply.v1 output",
  "type": "object",
  "required": ["text"],
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string" },
    "footnotes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["spanId", "quote"],
        "additionalProperties": false,
        "properties": {
          "spanId": { "type": "string", "pattern": "^D\\d+-P\\d+-S\\d+$" },
          "quote": { "type": "string" }
        }
      }
    }
  }
}
